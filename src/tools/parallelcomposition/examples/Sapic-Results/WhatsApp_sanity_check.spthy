lemma sanity_Heal:
  exists-trace "∃ sidA sidB #i. Heal( sidA, sidB ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ sidA sidB #i. (Heal( sidA, sidB ) @ #i)"
*/
simplify
solve( Heal( sidA, sidB ) @ #i )
  case eventHealsessionAlicesessionBob_0_11112121212121212121211121111111
  solve( State_11112121212121212121211121111111( ~Alice, ~Bob,
                                                 ~Ephemeral_sy, ~Root_sy, lock, lock.1
         ) ▶₀ #i )
    case insertsessionBobparshkdfRootsyEphemeralsy_0_1111212121212121212121112111111
    SOLVED // trace found
  qed
qed

