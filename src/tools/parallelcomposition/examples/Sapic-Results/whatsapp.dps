free att.
free s1.
free s2.
fun hash/1.
fun hash2/2.
fun hkdf/2.
fun pair/2.
fun pars1/1.
fun pars2/1.
fun senc/2.
fun session/1.
reduc   fst((x_1, x_2)) = x_1.
reduc   sdec(senc(x_1, x_2), x_2) = x_1.
reduc   snd((x_1, x_2)) = x_2.

let SessionCipherEncryptA(sidA_1, sidB_1, Alice_1)=
    in(sidA_1,CKs_1);
    let MKs_1=hash2(CKs_1, s1) in
    new payload_1;
    let Enc_1=senc(payload_1, MKs_1) in
    out(att,Enc_1);
    let CKsNext_1=hash2(CKs_1, s2) in
    out(sidA_1,CKsNext_1).



let SessionCipherEncryptB(sidA_1, sidB_1, Alice_1)=
    in(sidA_1,CKs_1);
    let MKs_1=hash2(CKs_1, s1) in
    new payload_1;
    let Enc_1=senc(payload_1, MKs_1) in
     out(att,Enc_1);
         new Root_sy_1;
         new Ephemeral_sy_1;
         let CKsNew_1=pars1(hkdf(Root_sy_1, Ephemeral_sy_1)) in
         let RKs_1=pars2(hkdf(Root_sy_1, Ephemeral_sy_1)) in
         out(sidA_1,CKsNew_1);
         out(sidB_1,CKsNew_1);
         0.



let SessionCipherDecryptA(sidA_1, sidB_1, Bob_1)=
        in(sidB_1,CKe_1);
         let MKe_1=hash2(CKe_1, s1) in
         in(att,a_1);
         let Dec_1=sdec(a_1, MKe_1) in 
         let CKeNext_1=hash2(CKe_1, s2) in
         out(sidB_1,CKeNext_1).


let SessionCipherDecryptB(sidA_1, sidB_1, Bob_1)=
new Root_sy_1;
      new Ephemeral_sy_1;
      let CKe_2=pars1(hkdf(Root_sy_1, Ephemeral_sy_1)) in
      let RKe_1=pars2(hkdf(Root_sy_1, Ephemeral_sy_1)) in
          out(sidA_1,CKe_2);
           out(sidB_1,CKe_2);
           let MKe_2=hash2(CKe_2, s1) in
           in(att,a_2);
           let Dec_2=sdec(a_2, MKe_2) in
           let CKeNext_2=hash2(CKe_2, s2) in
           out(sidB_1,CKeNext_2).




let SessionCipherDecryptC(sidA_1, sidB_1, Bob_1)=
new Root_sy_1;
      new Ephemeral_sy_1;
      let CKe_2=pars1(hkdf(Root_sy_1, Ephemeral_sy_1)) in
      let RKe_1=pars2(hkdf(Root_sy_1, Ephemeral_sy_1)) in
new ephemeral_secret_1;
        let CKeNew_1=pars1(hkdf(RKe_1, ephemeral_secret_1)) in
        let RKeNew_1=pars2(hkdf(RKe_1, ephemeral_secret_1)) in
        out(sidA_1,CKeNew_1);
        out(sidB_1,CKeNew_1);        
        let MKe_3=hash2(CKeNew_1, s1) in
        in(att,a_3);
        let Dec_3=sdec(a_3, MKe_3) in   
        let CKeNext_3=hash2(CKeNew_1, s2) in
        out(sidB_1,CKeNext_3).



let SessionCipherEncryptD(sidA_1, sidB_1, Alice_1)=
    in(att,CKs_1);
    let MKs_1=hash2(CKs_1, s1) in
    new payload_1;
    let Enc_1=senc(payload_1, MKs_1) in
    out(att,Enc_1);
    let CKsNext_1=hash2(CKs_1, s2) in
    out(att,CKsNext_1).

let SessionCipherDecryptD(sidA_1, sidB_1, Bob_1)=
         in(att,CKe_1);
         let MKe_1=hash2(CKe_1, s1) in
         in(att,a_1);
         let Dec_1=sdec(a_1, MKe_1) in 
         let CKeNext_1=hash2(CKe_1, s2) in
         out(att,CKeNext_1).



let processA =
    new Alice_1;
    new Bob_1;
    new sidAlice_1;
    new sidBob_1;
    new RootInit_1;
    new EphemeralInit_1;
    let CK_1=pars1(hkdf(RootInit_1, EphemeralInit_1)) in
    out(sidAlice_1 , CK_1);
    out(sidBob_1 , CK_1);
    !^2
    (!^2
     (((SessionCipherEncryptA(sidAlice_1, sidBob_1, Alice_1))
     | (!^2
        (((SessionCipherEncryptA(sidAlice_1, sidBob_1, Bob_1))
        | (!^2
           (((SessionCipherDecryptA(sidAlice_1, sidBob_1, Alice_1))
           | (!^2
              (((SessionCipherDecryptA(sidAlice_1, sidBob_1, Bob_1)))))))))))))).
 
                 

let processD =
    new Alice_1;
    new Bob_1;
    new sidAlice_1;
    new sidBob_1;
    new RootInit_1;
    new EphemeralInit_1;
    let CK_1=pars1(hkdf(RootInit_1, EphemeralInit_1)) in
    out(att , CK_1);
    !^2
    (!^2
     (((SessionCipherEncryptD(sidAlice_1, sidBob_1, Alice_1))
     | (!^2
        (((SessionCipherEncryptD(sidAlice_1, sidBob_1, Bob_1))
        | (!^2
           (((SessionCipherDecryptD(sidAlice_1, sidBob_1, Alice_1))
           | (!^2
              (((SessionCipherDecryptD(sidAlice_1, sidBob_1, Bob_1)))))))))))))).
 


let processB =
    new Alice_1;
    new Bob_1;
    new sidAlice_1;
    new sidBob_1;
    new RootInit_1;
    new EphemeralInit_1;
    let CK_1=pars1(hkdf(RootInit_1, EphemeralInit_1)) in
    out(sidAlice_1 , CK_1);
    out(sidBob_1 , CK_1);
    !^2
    ((SessionCipherDecryptC(sidAlice_1, sidBob_1, Bob_1))
                 | (!^2
                    (((SessionCipherEncryptB(sidAlice_1, sidBob_1, Alice_1))
                    | (!^2
                       (((SessionCipherEncryptA(sidBob_1, sidAlice_1, Bob_1))
                       | (!^2
                          (((SessionCipherDecryptB(sidBob_1, sidAlice_1, Alice_1))
                          | (!^2
                             (((SessionCipherDecryptB(sidAlice_1, sidBob_1, Bob_1))
                             | ((SessionCipherDecryptC(sidBob_1, sidAlice_1, Alice_1)))))))))))))))).


query trace_equiv(processA, processB).
query session_equiv(processA, processB).

query trace_equiv(processA, processD).
query session_equiv(processA, processD).


