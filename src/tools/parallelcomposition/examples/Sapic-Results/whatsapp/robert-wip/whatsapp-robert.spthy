// BEGIN SANITY LEMMA

// currently only allow two parties, hence not necessary
/* lemma can_create_user: exists-trace */
/*   "Ex A B  #i. */
/*   AssociateDevice(A, B) @ i" */

lemma can_key_exchange: exists-trace
  "Ex A B rk #i.
  KeyExchange(A, B, rk) @ i"

lemma can_receive_sym_message: exists-trace
  "Ex A B rck payload #i.
  ReceivedMessage(A, B, rck, payload) @ i"

lemma can_receive_attacker: exists-trace
  "Ex A B rk rck payload #i #j.
  ReceivedMessage(A, B, rk, rck, payload) @ i
  & KU(payload)@j"

lemma can_ratchet_attacker: exists-trace
  "Ex A B rk rkother #i.
  AttackerAsymetricStep(A, B, rk, rkother) @ i"



// should work
// should be attack against forward secrecy, but missing clause like
// (All c. Compromise()@c ==> #c < #i) &
lemma attack_FS:
exists-trace
  "∃ B sid2 MK2 #j #k2 #l2 sid1 MK1 #i #k1 #l1.  
New_session(sid2,B)@j &
Send(sid2,MK2)@k2 &  
j < k2 &
KU(MK2)@l2 &
New_session(sid1,B)@i &
i < j &
Send(sid1,MK1)@k1 &  
i < k1 &
k1 < j &
KU(MK1)@l1
"

// rework this, model compromise per party
lemma ForwardSecrecy[reuse, use_induction]:
"
(All sid MK #i #j. Send(sid, MK)@i & KU(MK)@j
==>  (Ex #k. Compromise(sid)@k & k < i) 
   | (Ex #k. Compromise(sid)@k ) 
)
"

lemma secretMK[reuse]: //secrecy of the message key
  "(not (Ex MK sid #i #j. (Send(sid,MK)@i & KU(MK)@j)))"



lemma authentication:
"All sid M #i. Receive(sid,M)@i
==> 
  (Ex #j. (Send(sid,M)@j) ∧ (j < i))"



// manual
lemma clone_detect:
exists-trace
  "∃ B sid1 sid2 MK #i #j #k. New_session(sid1,B)@i & New_session(sid2,B)@j & Send(sid1,MK)@k & i < j & j < k"


// manual
lemma attack_pcs:
  exists-trace
  "∃ sid MK #i #j #k #l.
    	(Send(sid,MK) @ #i) ∧
        (!KU(MK) @ #j) ∧
        (Heal(sid) @ #l) ∧
       	(#l < #i) ∧
      	(Compromise(sid)@ #k) ∧
     	(#k < #l)"


// idea for streamlining
/* Send() & KU () & (All Compromise => Ex Heal & timeing) */

lemma compromise_by_attacker[reuse]: 
  "All sid MK #i #j #k.
    	(
	(Send(sid,MK)@i) ∧
	(!KU(MK)@j) ∧
	(Heal(sid)@k) ∧
	(#k < #i) ∧
	(#k < #j)
	) ==> 
	(∃ #l.
	(Compromise(sid)@l) ∧ 
	(#k < #l)
	)
"


lemma same_session[reuse]: 
  "All sid1 sid2 MK #i #j.
    	(
	 (Send(sid1,MK)@ #i) ∧ (Receive(sid2,MK)@j) 
	) ==> 
	(
	sid1 = sid2
	)
"



