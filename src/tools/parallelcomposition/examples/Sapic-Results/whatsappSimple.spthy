
/*
 * Protocol: WhatsApp
*/



theory WhatsApp

begin

builtins: multiset

functions: hash2/2, enc/2, hkdf/2, pars1/1, pars2/1, dec/2[destructor], hash/1, session/1

equations: dec(enc(m, k), k) = m

heuristic: S


let SessionCipherEncrypt(sidA,sidB,Alice) =
lock sidA;
lookup sidA as CKs in 
let MKs=hash2(CKs,'1') in 
new ~payload;
let Enc=enc(~payload,MKs) in 
out(Enc);
event Send(sidA,sidB,MKs);
(out(MKs);
unlock sidA)+(
(lock sidB;
new ~Root_sy;
new ~Ephemeral_sy;
let CKsNew=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
let RKs=pars2(hkdf(~Root_sy,~Ephemeral_sy)) in
insert sidA,CKsNew;
insert sidB,CKsNew;
event Heal(sidA,sidB);
unlock sidA;
unlock sidB)+(
let CKsNext=hash2(CKs,'2') in 
insert sidA,CKsNext;
unlock sidA)
)




let SessionCipherDecrypt(sidA,sidB,Bob) =
(lock sidB;
lookup sidB as CKe in 
let MKe=hash2(CKe,'1') in 
in(a);
let Dec=dec(a,MKe) in 
event Receive(sidA,sidB,MKe);
let CKeNext=hash2(CKe,'2') in 
insert sidB,CKeNext;
unlock sidB)+(
lock sidA;
lock sidB;
new ~Root_sy;
new ~Ephemeral_sy;
let CKe=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
let RKe=pars2(hkdf(~Root_sy,~Ephemeral_sy)) in
insert sidA,CKe;
insert sidB,CKe;
event Heal(sidA,sidB);
(
let MKe=hash2(CKe,'1') in 
in(a);
let Dec=dec(a,MKe) in 
event Receive(sidA,sidB,MKe);
let CKeNext=hash2(CKe,'2') in 
insert sidB,CKeNext;
unlock sidA;
unlock sidB
)+(
new ~ephemeral_secret;
let CKeNew=pars1(hkdf(RKe,~ephemeral_secret)) in 
let RKeNew=pars2(hkdf(RKe,~ephemeral_secret)) in
insert sidA,CKeNew;
insert sidB,CKeNew;
event Heal(sidA,sidB);
let MKe=hash2(CKeNew,'1') in 
in(a);
let Dec=dec(a,MKe) in 
event Receive(sidA,sidB,MKe);
let CKeNext=hash2(CKeNew,'2') in 
insert sidB,CKeNext;
unlock sidA;
unlock sidB
)
)




let CompromiseSession(sidA,sidB) =
lock sidA;
lock sidB;
lookup sidA as CKa in
lookup sidB as CKb in 
(
let MKa=hash2(CKa,'1') in
let MKb=hash2(CKb,'1') in 
out(MKa);
out(MKb);
event Compromise(sidA,sidB);
unlock sidA;
unlock sidB
)+(
out(CKa);
out(CKb);
event Compromise(sidA,sidB);
unlock sidA;
unlock sidB
)




let NewSession(sidA,sidB,P) =
lock sidA;
lock sidB;
new ~Root_sy;
new ~Ephemeral_sy;
let CKn=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
insert sidA,CKn;
insert sidB,CKn;
event New_session(sidA,sidB,P);
unlock sidA;
unlock sidB



let MsgNewSession(sidA,sidB,P) =
lock sidA;
lock sidB;
in(am);
new ~Root_sy;
new ~Ephemeral_sy;
let CKm=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
insert sidA,CKm;
insert sidB,CKm;
event Msg_new_session(am,sidA,sidB,P);
unlock sidA;
unlock sidB



process:
new ~Alice;
new ~Bob;
let sidAlice = session(~Alice) in
let sidBob = session(~Bob) in
lock sidAlice;
lock sidBob;
new ~RootInit;
new ~EphemeralInit;
let CK=pars1(hkdf(~RootInit,~EphemeralInit)) in 
insert sidAlice,CK;
insert sidBob,CK;
unlock sidAlice;
unlock sidBob;
!(
!(NewSession(sidAlice,sidBob,~Alice)) | 
!(NewSession(sidAlice,sidBob,~Bob)) | 
!(MsgNewSession(sidAlice,sidBob,~Alice)) | 
!(MsgNewSession(sidAlice,sidBob,~Bob)) | 
!(CompromiseSession(sidAlice,sidBob)) | 
!(SessionCipherEncrypt(sidAlice,sidBob,~Alice)) | 
!(SessionCipherEncrypt(sidBob,sidAlice,~Bob)) | 
!(SessionCipherDecrypt(sidBob,sidAlice,~Alice)) |
!(SessionCipherDecrypt(sidAlice,sidBob,~Bob)) |
0
)







lemma IsInSrc [sources]:
  all-traces
  "∀ x y #i.
    (IsIn( x, y ) @ #i) ⇒
    (((∃ p1 p2. y = hash2(p1, p2)) ∨
      (∃ p1 p2. y = pars1(hkdf(p1, p2)))) ∨
     (∃ p1. y = hash(p1)))"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i.
  (IsIn( x, y ) @ #i)
 ∧
  (∀ p1 p2. (y = hash2(p1, p2)) ⇒ ⊥) ∧
  (∀ p1 p2. (y = pars1(hkdf(p1, p2))) ⇒ ⊥) ∧
  (∀ p1. (y = hash(p1)) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( Insert( x, y ) @ #t2 )
    case insertsessionAlicehashCKe_0_1111111111112121212121212111111111
    by contradiction /* from formulas */
  next
    case insertsessionAlicehashCKs_0_11111111111121212121211111122
    by contradiction /* from formulas */
  next
    case insertsessionAlicehashparshkdfRootsyEphemeralsy_0_1111111111112121212121212111211111111111
    by contradiction /* from formulas */
  next
    case insertsessionAlicehashparshkdfparshkdfRootsyEphemeralsyephemeralsecret_0_11111111111121212121212121112111121111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootInitEphemeralInit_0_111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_111111111111111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_11111111111121111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_11111111111121211111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_1111111111112121211111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_11111111111121212121211111121111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_11111111111121212121212111111211111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_11111111111121212121212121112111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_111111111111212121212121212111211111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfparshkdfRootsyEphemeralsyephemeralsecret_0_111111111111212121212121211121111211
    by contradiction /* from formulas */
  next
    case insertsessionBobhashCKe_0_111111111111212121212121212111111111
    by contradiction /* from formulas */
  next
    case insertsessionBobhashCKs_0_1111111111112121212121211111122
    by contradiction /* from formulas */
  next
    case insertsessionBobhashparshkdfRootsyEphemeralsy_0_111111111111212121212121212111211111111111
    by contradiction /* from formulas */
  next
    case insertsessionBobhashparshkdfparshkdfRootsyEphemeralsyephemeralsecret_0_1111111111112121212121212121112111121111111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootInitEphemeralInit_0_1111111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootsyEphemeralsy_0_1111111111111111111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootsyEphemeralsy_0_111111111111211111111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootsyEphemeralsy_0_111111111111212111111111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootsyEphemeralsy_0_11111111111121212111111111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootsyEphemeralsy_0_111111111111212121212111111211111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootsyEphemeralsy_0_1111111111112121212121211111121111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootsyEphemeralsy_0_1111111111112121212121212111211111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfRootsyEphemeralsy_0_1111111111112121212121212121112111111
    by contradiction /* from formulas */
  next
    case insertsessionBobparshkdfparshkdfRootsyEphemeralsyephemeralsecret_0_11111111111121212121212121211121111211
    by contradiction /* from formulas */
  next
    case newephemeralsecret_0_1111111111112121212121212111211112
    by contradiction /* from formulas */
