let system1 =
new A; new B; new C; (NewSession(A,pkA) | NewSession(B,pkB) | NewSession(C,pkC)).

let system2 =
new A; new B; new D; (NewSession(A,pkA) | NewSession(B,pkB) | NewSession(D,pkD)).


