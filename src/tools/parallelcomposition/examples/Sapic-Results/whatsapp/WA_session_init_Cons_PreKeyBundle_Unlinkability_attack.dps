let NewSession(R19_sy_1,R20_sy_1)=
    let R0_9_1=Load(MEM_sy, R19_sy_1) in
    let R1_14_1=Load(MEM_sy, Plus(R19_sy_1, s8)) in
    let R2_23_1=Load(MEM_sy, Plus(R20_sy_1, s64)) in
    let Ver_25_1=verify3(R0_9_1, R2_23_1, R1_14_1) in
    if LowCast(Ver_25_1, s32)=s0 then
        (out(att,s15622020))
    else(out(att,s15621684);
         let R25_58_1=Load(MEM_sy, Plus(R20_sy_1, s48)) in
         if R25_58_1=s0 then
             (out(att,s15622032))
         else(out(att,s15621692);
              let R23_97_1=Load(MEM_sy, Plus(R20_sy_1, s32)) in
