lemma sanity_New_session:
exists-trace
  "(Ex sidA sidB #i. (New_session(sidA,sidB)@i))"


lemma sanity_Msg_new_session:
exists-trace
  "(Ex M sidA sidB #i. (Msg_new_session(M,sidA,sidB)@i))"

lemma sanity_Send:
exists-trace
  "(Ex M sidA sidB #i. (Send(sidA,sidB,M)@i))"

lemma sanity_Receive:
exists-trace
  "(Ex M sidA sidB #i. (Receive(sidA,sidB,M)@i))"


lemma sanity_Heal:
exists-trace
  "(Ex sidA sidB #i. (Heal(sidA,sidB)@i))"

lemma sanity_Compromise:
exists-trace
  "(Ex sidA sidB #i. (Compromise(sidA,sidB)@i))"


lemma IsInSrc[sources]:
    " All x y #i .
        IsIn(x,y)@i ==> 
        (Ex p1 p2 . y =hash2(p1,p2)) |
        (Ex p1 p2 . y =pars1(hkdf(p1,p2))) |
        (Ex p1 . y =hash(p1)) 
        "
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( Insert( x, y ) @ #t2 )
    case insertSessionIdCKs_0_1111121212121212111111111
    by sorry
  qed
qed

