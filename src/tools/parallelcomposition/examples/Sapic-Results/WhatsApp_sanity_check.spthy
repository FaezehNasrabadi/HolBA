lemma IsInSrc [sources]:
  all-traces
  "∀ x y #i.
    (IsIn( x, y ) @ #i) ⇒
    (((∃ p1 p2. y = hash2(p1, p2)) ∨
      (∃ p1 p2. y = pars1(hkdf(p1, p2)))) ∨
     (∃ p1. y = hash(p1)))"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i.
  (IsIn( x, y ) @ #i)
 ∧
  (∀ p1 p2. (y = hash2(p1, p2)) ⇒ ⊥) ∧
  (∀ p1 p2. (y = pars1(hkdf(p1, p2))) ⇒ ⊥) ∧
  (∀ p1. (y = hash(p1)) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction
next
  case non_empty_trace
  simplify
  solve( Insert( x, y ) @ #t2 )
    case insertsessionAlicehashCKe_0_1111212121212121212111111111
    by contradiction /* from formulas */
  next
    case insertsessionAlicehashCKs_0_11112121212121211111122
    by contradiction /* from formulas */
  next
    case insertsessionAlicehashparshkdfRootsyEphemeralsy_0_1111212121212121212111211111111111
    by contradiction /* from formulas */
  next
    case insertsessionAlicehashparshkdfparshkdfRootsyEphemeralsyephemeralsecret_0_11112121212121212121112111121111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_1111111111
    by contradiction /* from formulas */
  next
    case insertsessionAliceparshkdfRootsyEphemeralsy_0_111121111111
