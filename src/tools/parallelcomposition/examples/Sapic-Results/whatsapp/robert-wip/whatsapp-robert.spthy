theory WhatsApp

begin

builtins: multiset

functions: hash2/2, enc/2, hkdf/2, pars1/1, pars2/1, dec/2[destructor], hash/1, session/1

equations: dec(enc(m, k), k) = m

heuristic: S

let SessionCipherEncrypt(A,B,Alice) =
lock sidA;
lookup sidA as CKs in 
let MKs=hash2(CKs,'1') in 
new ~payload;
let Enc=enc(~payload,MKs) in 
out(Enc);
event Send(sidA,sidB,MKs);
(out(MKs);
unlock sidA)+(
(lock sidB;
new ~Root_sy;
new ~Ephemeral_sy;
let CKsNew=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
let RKs=pars2(hkdf(~Root_sy,~Ephemeral_sy)) in
insert sidA,CKsNew;
insert sidB,CKsNew;
event Heal(sidA,sidB);
unlock sidA;
unlock sidB)+(
let CKsNext=hash2(CKs,'2') in 
insert sidA,CKsNext;
unlock sidA)
)



// first path in SessionCipherDecrypt
let SessionCipherDecrypt1(B,A,Bob) =
    lock B; // runs on B's computer
    lookup <B,A,'rcv'> as CKe in 
    let MKe=hash2(CKe,'1') in 
    in(a); 
    let Dec=dec(a,MKe) in 
    /* event Receive(sidA,sidB,MKe); //old event, remove later */
    event ReceivedMessage(B, A, MKe, Dec); // removed CK from event, because it does not actually occur
    let CKeNext=hash2(CKe,'2') in 
    insert <B,A,'rcv'>, CKeNext;
    unlock B


// sythesized from 4 path .. need to add others
let SessionCipherDecrypt(B,A,Bob) =
    SessionCipherDecrypt1(B,A,Bob)
