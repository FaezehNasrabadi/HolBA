    	(
	 (Send(sid1,MK)@ #i) ∧ (Receive(sid2,MK)@j) 
	) ==> 
	(
	sid1 = sid2
	)
"



process:
!(
new sid;
insert sid,'init';
!(
lock sid;
lookup sid as lio in
event Read(lio)
))


