
/*
 * Protocol: WhatsApp
*/



theory WhatsApp

begin

builtins: multiset

functions: hash2/2, enc/2, hkdf/2, pars1/1, pars2/1, dec/2[destructor], hash/1, session/1

equations: dec(enc(m, k), k) = m

heuristic: S


let SessionCipherEncrypt(sidA,sidB,Alice) =
lock sidA;
lookup sidA as CKs in 
let MKs=hash2(CKs,'1') in 
new ~payload;
let Enc=enc(~payload,MKs) in 
out(Enc);
event Send(sidA,sidB,MKs);
(out(MKs);
unlock sidA)+(
(lock sidB;
new ~Root_sy;
new ~Ephemeral_sy;
let CKsNew=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
let RKs=pars2(hkdf(~Root_sy,~Ephemeral_sy)) in
insert sidA,CKsNew;
insert sidB,CKsNew;
event Heal(sidA,sidB);
unlock sidA;
unlock sidB)+(
let CKsNext=hash2(CKs,'2') in 
insert sidA,CKsNext;
unlock sidA)
)




let SessionCipherDecrypt(sidA,sidB,Bob) =
(lock sidB;
lookup sidB as CKe in 
let MKe=hash2(CKe,'1') in 
in(a);
let Dec=dec(a,MKe) in 
event Receive(sidA,sidB,MKe);
let CKeNext=hash2(CKe,'2') in 
insert sidB,CKeNext;
unlock sidB)+(
lock sidA;
lock sidB;
new ~Root_sy;
new ~Ephemeral_sy;
let CKe=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
let RKe=pars2(hkdf(~Root_sy,~Ephemeral_sy)) in
insert sidA,CKe;
insert sidB,CKe;
event Heal(sidA,sidB);
(
let MKe=hash2(CKe,'1') in 
in(a);
let Dec=dec(a,MKe) in 
event Receive(sidA,sidB,MKe);
let CKeNext=hash2(CKe,'2') in 
insert sidB,CKeNext;
unlock sidA;
unlock sidB
)+(
new ~ephemeral_secret;
let CKeNew=pars1(hkdf(RKe,~ephemeral_secret)) in 
let RKeNew=pars2(hkdf(RKe,~ephemeral_secret)) in
insert sidA,CKeNew;
insert sidB,CKeNew;
event Heal(sidA,sidB);
let MKe=hash2(CKeNew,'1') in 
in(a);
let Dec=dec(a,MKe) in 
event Receive(sidA,sidB,MKe);
let CKeNext=hash2(CKeNew,'2') in 
insert sidB,CKeNext;
unlock sidA;
unlock sidB
)
)




let CompromiseSession(sidA,sidB) =
lock sidA;
lock sidB;
lookup sidA as CKa in
lookup sidB as CKb in 
(
let MKa=hash2(CKa,'1') in
let MKb=hash2(CKb,'1') in 
out(MKa);
out(MKb);
event Compromise(sidA,sidB);
unlock sidA;
unlock sidB
)+(
out(CKa);
out(CKb);
event Compromise(sidA,sidB);
unlock sidA;
unlock sidB
)




let NewSession(sidA,sidB) =
lock sidA;
lock sidB;
new ~Root_sy;
new ~Ephemeral_sy;
let CKn=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
insert sidA,CKn;
insert sidB,CKn;
event New_session(sidA,sidB);
unlock sidA;
unlock sidB



let MsgNewSession(sidA,sidB) =
lock sidA;
lock sidB;
in(am);
new ~Root_sy;
new ~Ephemeral_sy;
let CKm=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
insert sidA,CKm;
insert sidB,CKm;
event Msg_new_session(am,sidA,sidB);
unlock sidA;
unlock sidB



process:
new ~Alice;
new ~Bob;
let sidAlice = session(~Alice) in
let sidBob = session(~Bob) in
!(
!(NewSession(sidAlice,sidBob)) | 
!(NewSession(sidAlice,sidBob)) | 
!(MsgNewSession(sidAlice,sidBob)) | 
!(MsgNewSession(sidAlice,sidBob)) | 
!(CompromiseSession(sidAlice,sidBob)) | 
!(CompromiseSession(sidAlice,sidBob)) | 
!(SessionCipherEncrypt(sidAlice,sidBob,~Alice)) | 
!(SessionCipherEncrypt(sidBob,sidAlice,~Bob)) | 
!(SessionCipherDecrypt(sidBob,sidAlice,~Alice)) |
!(SessionCipherDecrypt(sidAlice,sidBob,~Bob)) |
0
)

