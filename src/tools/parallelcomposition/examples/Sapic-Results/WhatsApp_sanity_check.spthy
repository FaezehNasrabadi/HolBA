lemma sanity_New_session:
  exists-trace "∃ sidA sidB #i. New_session( sidA, sidB ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ sidA sidB #i. (New_session( sidA, sidB ) @ #i)"
*/
simplify
solve( New_session( sidA, sidB ) @ #i )
  case eventNewsessionsessionAlicesessionBob_0_111111111111
  solve( State_111111111111( lock, ~Alice, ~Bob, ~Ephemeral_sy,
                             ~Root_sy, lock.1
         ) ▶₀ #i )
    case insertsessionBobparshkdfRootsyEphemeralsy_0_11111111111
    SOLVED // trace found
  qed
qed

