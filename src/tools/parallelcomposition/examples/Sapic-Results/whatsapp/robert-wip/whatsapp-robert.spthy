// generated by hand (part of threat model)
let CompromiseSession(sidA,sidB) =
lock sidA;
lock sidB;
lookup sidA as CKa in
lookup sidB as CKb in 
out(CKa);
out(CKb);
event Compromise(sidA,sidB);
unlock sidA;
unlock sidB



// synthesized, but rootkey added manually
let NewSession(A,B) =
    new ~Root_sy; // not synthesized
    insert <A,'rootkey'>, ~Root_sy; //not synthesized. Could be from translation, but we do not translate that part of the code yet.
    new ~Ephemeral_sy;
    let CKn=pars1(hkdf(~Root_sy,~Ephemeral_sy)) in 
    insert <A,B,'snd'>,CKn;
    insert <B,A,'rcv'>,CKn; // abstraction of X3DH-> B is magically given the same CKn
    event KeyExchange(A,B,~Root_sy)


